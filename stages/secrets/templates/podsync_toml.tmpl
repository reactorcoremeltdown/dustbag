[server]
port = 26000
{{- with getSecretByName "48db0363-b9ae-4cae-a7a4-ce72b49b8174" "prod" "/Apps/Podsync" "PODSYNC_HOSTNAME" }}
hostname = {{ .Value }}
{{- end }}
data_dir = "/var/lib/podsync"

[tokens]
{{- with getSecretByName "48db0363-b9ae-4cae-a7a4-ce72b49b8174" "prod" "/Apps/Podsync" "PODSYNC_YOUTUBE_TOKEN" }}
youtube = {{ .Value }}
{{- end }}
[feeds]
{{- with getSecretByName "48db0363-b9ae-4cae-a7a4-ce72b49b8174" "prod" "/Apps/Podsync" "PODSYNC_FEEDS" }}
{{ .Value | nindent 2 }}
{{- end }}

[database]
  badger = { truncate = true, file_io = true }

[downloader]
self_update = true
timeout = 45
debug_hook = "/usr/local/bin/youtube_debug_logger.sh"

[log]
filename = "/var/log/podsync/podsync.log"
max_size = 50 # MB
max_age = 30 # days
max_backups = 7
compress = true
